class SearchControllerIntegrationTestDisabled {

    private static final WireMockServer WIREMOCK = new WireMockServer(options().dynamicPort());

    @DynamicPropertySource
    static void registerDynamicProperties(DynamicPropertyRegistry registry) {
        registry.add("app.pubmed.api.base-url", WIREMOCK::baseUrl);
        registry.add("app.mesh.api.base-url", WIREMOCK::baseUrl);
    }

    @BeforeAll
    static void startWireMock() {
        WIREMOCK.start();
    }

    @AfterAll
    static void stopServers() {
        WIREMOCK.stop();
    }

    @Autowired
    private MockMvc mockMvc;

    @Autowired
    private ObjectMapper objectMapper;

    @Autowired
    private JwtTokenProvider jwtTokenProvider;

    @Autowired
    private UserRepository userRepository;

    @Autowired
    private SearchSessionRepository searchSessionRepository;

    @Autowired
    private SearchResultRepository searchResultRepository;

    @MockitoBean
    private HealthSearchProxyService healthSearchProxyService;

    @MockitoSpyBean
    private SearchServiceImpl searchService;

    private User studentUser;
    private String jwtToken;

    @BeforeEach
    void setUp() {
        WIREMOCK.resetAll();
        Mockito.reset(healthSearchProxyService, searchService);
        searchSessionRepository.deleteAll();
        searchResultRepository.deleteAll();
        userRepository.deleteAll();

        studentUser = new User();
        studentUser.setUsername("laura.medina");
        studentUser.setEmail("laura.medina@edusearch.edu");
        studentUser.setPasswordHash("$2a$10$abcdefghijklmnopqrstuv");
        studentUser.setFirstName("Laura");
        studentUser.setLastName("Medina");
        studentUser.setRole(Role.ROLE_STUDENT);
        studentUser.setFaculty("Medicina");
        studentUser.setDepartment("Epidemiologia");
        studentUser.setActive(true);
        studentUser = userRepository.save(studentUser);

        jwtToken = jwtTokenProvider.generateTokenFromUsername(studentUser.getEmail(), "ROLE_STUDENT");

        when(healthSearchProxyService.search(anyString(), anyInt(), any()))
            .thenReturn(new com.uci.competencia.model.dto.response.ExternalHealthSearchResponseDTO(
                "none",
                List.of(),
                0,
                false,
                java.time.Instant.now().toString()
            ));
    }

    @Test
    @DisplayName("POST /api/search/execute returns 200 and renders one scientific article from PubMed with MeSH filters")
    void shouldExecuteScientificSearchWithMeshFiltersAndReturnPubMedResults() throws Exception {
        stubPubMedSearchWithSystematicReview();

        String requestBody = """
            {
              "query": {
                "terms": ["insulin resistance", "diabetes type 2"],
                "operators": ["AND"],
                "meshTerms": ["D007333", "D003924"]
              },
              "filters": {
                "yearFrom": 2020,
                "yearTo": 2025,
                "studyTypes": ["systematic_review"],
                "hasFullText": true,
                "language": "en",
                "maxResults": 20
              },
              "context": {
                "userId": "%s",
                "isPractice": false
              }
            }
            """.formatted(studentUser.getId());

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isOk())
            .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
            .andExpect(jsonPath("$.searchId", notNullValue()))
            .andExpect(jsonPath("$.metadata.totalResults").value(1))
            .andExpect(jsonPath("$.metadata.fallbackUsed").value(false))
            .andExpect(jsonPath("$.results", hasSize(1)))
            .andExpect(jsonPath("$.results[0].pmid").value("39876543"))
            .andExpect(jsonPath("$.results[0].title").value("Insulin Resistance in Type 2 Diabetes: A Systematic Review"))
            .andExpect(jsonPath("$.results[0].authors[0]").value("Laura Medina"))
            .andExpect(jsonPath("$.results[0].journal").value("The Lancet Diabetes & Endocrinology"))
            .andExpect(jsonPath("$.results[0].year").value(2024))
            .andExpect(jsonPath("$.results[0].studyType").value("systematic_review"))
            .andExpect(jsonPath("$.results[0].evidenceLevel").value(1))
            .andExpect(jsonPath("$.results[0].meshTerms[0]").value("Insulin Resistance"))
            .andExpect(jsonPath("$.results[0].meshTerms[1]").value("Diabetes Mellitus, Type 2"));

        verify(healthSearchProxyService, never()).search(anyString(), anyInt(), any());

        SearchSession persistedSession = searchSessionRepository.findAll().getFirst();
        assertEquals(studentUser.getId(), persistedSession.getUser().getId());
        assertEquals("insulin resistance diabetes type 2", persistedSession.getOriginalQuery());
        assertNotNull(persistedSession.getFiltersApplied());

        JsonNode storedRequest = objectMapper.readTree(persistedSession.getFiltersApplied());
        assertEquals("D007333", storedRequest.path("query").path("meshTerms").get(0).asText());
        assertEquals("D003924", storedRequest.path("query").path("meshTerms").get(1).asText());
        assertEquals(20, storedRequest.path("filters").path("maxResults").asInt());

        WIREMOCK.verify(getRequestedFor(urlPathEqualTo("/esearch.fcgi"))
            .withQueryParam("term", matching(".*Insulin Resistance\\[MeSH\\].*"))
            .withQueryParam("term", matching(".*Diabetes Mellitus, Type 2\\[MeSH\\].*"))
            .withQueryParam("term", containing("2020:2025[PDAT]"))
            .withQueryParam("term", containing("free full text[filter]"))
            .withQueryParam("term", containing("en[lang]")));
    }

    @Test
    @DisplayName("POST /api/search/execute returns 200 with local scientific results when PubMed returns empty list")
    void shouldReturnLocalScientificResultsWhenExternalProviderHasNoMatches() throws Exception {
        stubPubMedSearchWithoutMatches();

        SearchResult localResult = new SearchResult();
        localResult.setPmid("31234567");
        localResult.setTitle("Insulin resistance in diabetes type 2 cohorts from Latin America");
        localResult.setAbstractText("Cohort study in medical students and adult patients. n=320");
        localResult.setAuthors("Ana Torres; Carlos Ramos");
        localResult.setJournal("Revista Cubana de Endocrinologia");
        localResult.setPublicationDate(LocalDate.of(2023, 5, 10));
        localResult.setPublicationYear(2023);
        localResult.setStudyType(StudyType.COHORT_STUDY);
        localResult.setEvidenceLevel(3);
        localResult.setHasFullText(true);
        localResult.setFullTextUrl("https://edusearch.local/articles/31234567");
        localResult.setSampleSize(320);
        localResult.setHasConflictOfInterest(false);
        localResult.setDoi("10.1234/edusearch.2023.320");
        localResult.setMeshTerms(List.of("Insulin Resistance", "Diabetes Mellitus, Type 2"));
        searchResultRepository.save(localResult);

        String requestBody = """
            {
              "query": {
                "terms": ["insulin resistance", "diabetes type 2"],
                "operators": ["AND"],
                "meshTerms": ["D007333", "D003924"]
              },
              "filters": {
                "yearFrom": 2020,
                "yearTo": 2025,
                "studyTypes": ["cohort"],
                "hasFullText": true,
                "maxResults": 10
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.metadata.totalResults").value(1))
            .andExpect(jsonPath("$.metadata.fallbackUsed").value(true))
            .andExpect(jsonPath("$.metadata.warnings[0]").value(
                "Se usaron resultados locales por ausencia de resultados directos en PubMed."))
            .andExpect(jsonPath("$.results[0].pmid").value("31234567"))
            .andExpect(jsonPath("$.results[0].studyType").value("cohort"))
            .andExpect(jsonPath("$.results[0].authors", hasSize(2)))
            .andExpect(jsonPath("$.results[0].authors[1]").value("Carlos Ramos"))
            .andExpect(jsonPath("$.results[0].sampleSize").value(320))
            .andExpect(jsonPath("$.results[0].hasConflictOfInterest").value(false));
    }

    @Test
    @DisplayName("POST /api/search/execute returns 200 with empty scientific list when no provider has evidence")
    void shouldReturnEmptyScientificListWhenNoEvidenceIsAvailable() throws Exception {
        stubPubMedSearchWithoutMatches();

        String requestBody = """
            {
              "query": {
                "terms": ["rare endocrine misinformation"],
                "operators": [],
                "meshTerms": ["D999999"]
              },
              "filters": {
                "yearFrom": 2024,
                "yearTo": 2025,
                "studyTypes": ["systematic_review"],
                "maxResults": 5
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.metadata.totalResults").value(0))
            .andExpect(jsonPath("$.metadata.fallbackUsed").value(false))
            .andExpect(jsonPath("$.results", hasSize(0)));

        assertEquals(1, searchSessionRepository.count());
    }

    @Test
    @DisplayName("POST /api/search/execute currently returns 200 with empty results when terms list is empty")
    void shouldDocumentCurrentBehaviorForEmptySearchTerms() throws Exception {
        String requestBody = """
            {
              "query": {
                "terms": [],
                "operators": ["AND"],
                "meshTerms": ["D007333"]
              },
              "filters": {
                "maxResults": 10
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.metadata.totalResults").value(0))
            .andExpect(jsonPath("$.results", hasSize(0)));
    }

    @Test
    @DisplayName("POST /api/search/execute currently accepts oversized MeSH filters because nested validation is not cascaded")
    void shouldDocumentCurrentBehaviorForTooManyMeshTerms() throws Exception {
        stubPubMedSearchWithoutMatches();

        String requestBody = """
            {
              "query": {
                "terms": ["diabetes"],
                "operators": [],
                "meshTerms": [
                  "D1","D2","D3","D4","D5","D6","D7","D8","D9","D10","D11"
                ]
              },
              "filters": {
                "maxResults": 700
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isOk())
            .andExpect(jsonPath("$.metadata.totalResults").value(0))
            .andExpect(jsonPath("$.results", hasSize(0)));

        SearchSession persistedSession = searchSessionRepository.findAll().getFirst();
        JsonNode storedRequest = objectMapper.readTree(persistedSession.getFiltersApplied());
        assertEquals(11, storedRequest.path("query").path("meshTerms").size());
        assertEquals(700, storedRequest.path("filters").path("maxResults").asInt());
    }

    @Test
    @DisplayName("POST /api/search/execute returns 400 when the root query object is missing")
    void shouldReturnBadRequestWhenRootQueryIsMissing() throws Exception {
        String requestBody = """
            {
              "filters": {
                "maxResults": 10
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isBadRequest())
            .andExpect(jsonPath("$.errorCode").value("VALIDATION_FAILED"))
            .andExpect(jsonPath("$.status").value(400))
            .andExpect(jsonPath("$.details.query").value("Search query cannot be null"));
    }

    @Test
    @DisplayName("POST /api/search/execute returns 400 when the request JSON is malformed")
    void shouldReturnBadRequestForMalformedJson() throws Exception {
        String malformedJson = """
            {
              "query": {
                "terms": ["diabetes type 2"]
                "operators": ["AND"]
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(malformedJson))
            .andExpect(status().isBadRequest())
            .andExpect(jsonPath("$.errorCode").value("INVALID_REQUEST_BODY"))
            .andExpect(jsonPath("$.status").value(400))
            .andExpect(jsonPath("$.path").value("/api/search/execute"));
    }

    @Test
    @DisplayName("POST /api/search/execute returns 500 when SearchService raises an unexpected runtime error")
    void shouldReturnInternalServerErrorWhenSearchServiceFailsUnexpectedly() throws Exception {
        doThrow(new RuntimeException("BioBERT semantic layer unavailable"))
            .when(searchService)
            .executeSearch(any(com.uci.competencia.model.dto.request.SearchRequestDTO.class));

        String requestBody = """
            {
              "query": {
                "terms": ["insulin resistance", "diabetes type 2"],
                "operators": ["AND"],
                "meshTerms": ["D007333", "D003924"]
              }
            }
            """;

        mockMvc.perform(post("/api/search/execute")
                .header("Authorization", "Bearer " + jwtToken)
                .contentType(MediaType.APPLICATION_JSON)
                .content(requestBody))
            .andExpect(status().isInternalServerError())
            .andExpect(jsonPath("$.errorCode").value("INTERNAL_SERVER_ERROR"))
            .andExpect(jsonPath("$.status").value(500))
            .andExpect(jsonPath("$.message").value("An unexpected error occurred"))
            .andExpect(jsonPath("$.path").value("/api/search/execute"));
    }

    @Test
    @DisplayName("GET /api/search/mesh/suggestions returns 200 with MeSH descriptor suggestions for React autocomplete")
    void shouldReturnMeshSuggestionsForAutocomplete() throws Exception {
        WIREMOCK.stubFor(com.github.tomakehurst.wiremock.client.WireMock.get(urlPathEqualTo("/lookup/descriptor"))
            .withQueryParam("label", equalTo("diabetes"))
            .willReturn(aResponse()
                .withHeader("Content-Type", "application/json")
                .withBody("""
                    [
                      {
                        "label": "Diabetes Mellitus",
                        "resource": "http://id.nlm.nih.gov/mesh/D003920"
                      },
                      {
                        "label": "Diabetes Mellitus, Type 2",
                        "resource": "http://id.nlm.nih.gov/mesh/D003924"
                      }
                    ]
                    """)));

        mockMvc.perform(org.springframework.test.web.servlet.request.MockMvcRequestBuilders.get("/api/search/mesh/suggestions")
                .header("Authorization", "Bearer " + jwtToken)
                .param("term", "diabetes"))
            .andExpect(status().isOk())
            .andExpect(content().contentTypeCompatibleWith(MediaType.APPLICATION_JSON))
            .andExpect(jsonPath("$", hasSize(2)))
            .andExpect(jsonPath("$[0].id").value("D003920"))
            .andExpect(jsonPath("$[0].term").value("Diabetes Mellitus"))
            .andExpect(jsonPath("$[1].id").value("D003924"))
            .andExpect(jsonPath("$[1].description").value("MeSH descriptor"));
    }

    private void stubPubMedSearchWithSystematicReview() {
        WIREMOCK.stubFor(com.github.tomakehurst.wiremock.client.WireMock.get(urlPathEqualTo("/esearch.fcgi"))
            .willReturn(aResponse()
                .withHeader("Content-Type", "application/json")
                .withBody("""
                    {
                      "esearchresult": {
                        "idlist": ["39876543"]
                      }
                    }
                    """)));

        WIREMOCK.stubFor(com.github.tomakehurst.wiremock.client.WireMock.get(urlPathEqualTo("/efetch.fcgi"))
            .willReturn(aResponse()
                .withHeader("Content-Type", "application/xml")
                .withBody("""
                    <?xml version="1.0" encoding="UTF-8"?>
                    <PubmedArticleSet>
                      <PubmedArticle>
                        <MedlineCitation>
                          <PMID>39876543</PMID>
                          <Article>
                            <ArticleTitle>Insulin Resistance in Type 2 Diabetes: A Systematic Review</ArticleTitle>
                            <Abstract>
                              <AbstractText>Systematic review of metabolic evidence in adult patients. n=1240</AbstractText>
                            </Abstract>
                            <AuthorList>
                              <Author>
                                <ForeName>Laura</ForeName>
                                <LastName>Medina</LastName>
                              </Author>
                              <Author>
                                <ForeName>Daniel</ForeName>
                                <LastName>Suarez</LastName>
                              </Author>
                            </AuthorList>
                            <Journal>
                              <Title>The Lancet Diabetes &amp; Endocrinology</Title>
                              <JournalIssue>
                                <PubDate>
                                  <Year>2024</Year>
                                  <Month>Apr</Month>
                                  <Day>12</Day>
                                </PubDate>
                              </JournalIssue>
                            </Journal>
                            <PublicationTypeList>
                              <PublicationType>Systematic Review</PublicationType>
                            </PublicationTypeList>
                          </Article>
                          <MeshHeadingList>
                            <MeshHeading>
                              <DescriptorName>Insulin Resistance</DescriptorName>
                            </MeshHeading>
                            <MeshHeading>
                              <DescriptorName>Diabetes Mellitus, Type 2</DescriptorName>
                            </MeshHeading>
                          </MeshHeadingList>
                        </MedlineCitation>
                        <PubmedData>
                          <ArticleIdList>
                            <ArticleId IdType="doi">10.1016/S2213-8587(24)00001-9</ArticleId>
                          </ArticleIdList>
                        </PubmedData>
                      </PubmedArticle>
                    </PubmedArticleSet>
                    """)));
    }

    private void stubPubMedSearchWithoutMatches() {
        WIREMOCK.stubFor(com.github.tomakehurst.wiremock.client.WireMock.get(urlPathEqualTo("/esearch.fcgi"))
            .willReturn(aResponse()
                .withHeader("Content-Type", "application/json")
                .withBody("""
                    {
                      "esearchresult": {
                        "idlist": []
                      }
                    }
                    """)));
    }

