# ============================================================
# EDUCEARCH - CONFIGURACIÓN DE ENTORNO
# ============================================================
# Copia este archivo como .env.local para desarrollo
# o configura estas variables en tu hosting para producción.
# ============================================================

# --- URL del Backend API ---
# En desarrollo: http://localhost:8080
# En producción: https://tu-dominio-backend.com
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- URL del Backend (comunicación interna) ---
# Para server-side requests (SSR, API routes)
BACKEND_INTERNAL_URL=http://localhost:8080

# --- WebSocket opcional ---
# Si se omite y NEXT_PUBLIC_API_URL=/api, el frontend usa /ws-native en el mismo host.
# NEXT_PUBLIC_WS_URL=http://localhost:8080

# --- Docker / Producción ---
FORCE_HTTPS=false
FRONTEND_BASE_URL=http://localhost:3000
SERVER_SSL_ENABLED=false
POSTGRES_PASSWORD=changeme
REDIS_PASSWORD=changeme
JWT_SECRET=change-me-with-at-least-32-random-characters
GOOGLE_AI_API_KEY=
PUBMED_API_KEY=
PUBMED_EMAIL=

# --- Orígenes CORS permitidos (separados por coma) ---
NEXT_ALLOWED_DEV_ORIGINS=http://localhost:3000

# --- Opcional: Analytics de Vercel ---
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# --- Opcional: Modo debug ---
# NEXT_PUBLIC_DEBUG=false
